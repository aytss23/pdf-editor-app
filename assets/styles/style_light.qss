/* ==========================================
   MODERN AYDINLIK TEMA (style_light.qss)
========================================== */

/* Genel Uygulama Ayarları */
QWidget {
    background-color: #F5F7FA;
    color: #2D3748;
    font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
}

/* Ana Pencere */
QMainWindow, #centralwidget {
    background-color: #F5F7FA;
}

/* Üst Başlık (Sarı arka planı ezer ve modernleştirir) */
#main_title_label {
    background-color: transparent !important;
    color: #3182CE !important; /* Kurumsal Mavi */
    font-size: 18px;
    font-weight: bold;
    padding-left: 5px;
}

/* Üst Kontrol Paneli (Frame) */
#frame {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
}

QPushButton {
    background-color: #EDF2F7; /* veya koyu temada #2D3748 */
    color: #4A5568;
    border: 1px solid #E2E8F0;
    border-radius: 5px;
    padding: 5px 10px; /* <--- SORUN BURADA */
    font-weight: 600;
}

QPushButton:hover {
    background-color: #E2E8F0;
    border-color: #CBD5E0;
    color: #2D3748;
}

QPushButton:pressed {
    background-color: #CBD5E0;
}

/* PHİ-3 Özel Butonu */
#zoom_in_push_button_2 {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #EBF4FF, stop:1 #C3DAFE);
    color: #2B6CB0;
    border: 1px solid #90CDF4;
}

#zoom_in_push_button_2:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #EBF4FF, stop:1 #A3BFFA);
}

/* Metin Giriş Kutuları (Sayfa Numaraları) */
QLineEdit {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E0;
    border-radius: 4px;
    padding: 3px;
    color: #2D3748;
    qproperty-alignment: 'Qt::AlignCenter';
    selection-background-color: #3182CE;
}

QLineEdit:focus {
    border: 2px solid #63B3ED;
}

/* Sekmeler (QTabWidget) */
QTabWidget::pane {
    border: 1px solid #E2E8F0;
    background-color: #FFFFFF;
    border-radius: 8px;
    top: -1px;
}

QTabBar::tab {
    background-color: #EDF2F7;
    color: #718096;
    border: 1px solid #E2E8F0;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 8px 16px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #FFFFFF;
    color: #2D3748;
    font-weight: bold;
    border-top: 3px solid #3182CE;
}

QTabBar::tab:hover:!selected {
    background-color: #E2E8F0;
}

/* PDF Görüntüleme Alanı */
QGraphicsView {
    border: none;
    background-color: #EDF2F7; /* PDF beyaz olduğu için arkası hafif gri olmalı */
    border-radius: 8px;
}

/* Modern Kaydırma Çubukları (Scrollbars) */
QScrollBar:vertical, QScrollBar:horizontal {
    border: none;
    background: #F5F7FA;
    width: 12px;
    height: 12px;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #CBD5E0;
    border-radius: 6px;
    min-height: 20px;
    min-width: 20px;
}

QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background: #A0AEC0;
}

QScrollBar::add-line, QScrollBar::sub-line {
    border: none;
    background: none;
}